@{
    ViewData["Title"] = "Iniciar evaluación";
}

<h1>Iniciar evaluación</h1>

<p class="text-muted">
    Selecciona la empresa y el formulario para comenzar
    la evaluación de ciberseguridad.
</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="empresaId" class="form-label">
                    Empresa
                </label>

                <select id="empresaId"
                        name="empresaId"
                        class="form-select"
                        asp-items="ViewBag.Empresas"
                        required>
                    <option value="">Seleccione su empresa</option>
                </select>

                <span class="form-text">
                    Solo puedes seleccionar empresas asociadas a tu cuenta.
                </span>
            </div>

            <div class="mb-3">
                <label for="formularioId" class="form-label">
                    Formulario de evaluación
                </label>

                <select id="formularioId"
                        name="formularioId"
                        class="form-select"
                        asp-items="ViewBag.Formularios"
                        required>
                    <option value="">Seleccione un formulario</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Comenzar evaluación
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
        </form>
    </div>
</div>
