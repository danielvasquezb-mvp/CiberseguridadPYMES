
@model CiberseguridadPYMES.Models.Evaluacion
@using CiberseguridadPYMES.Models

@{
    ViewData["Title"] = "Responder evaluación";

    var preguntas = ViewBag.Preguntas as IEnumerable<Pregunta>
        ?? Enumerable.Empty<Pregunta>();
}

<h1>Evaluación de ciberseguridad</h1>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.Formulario?.Nombre</h5>

        <p class="mb-1">
            <strong>Empresa:</strong> @Model.Empresa?.Nombre
        </p>

        <p class="mb-1">
            <strong>Versión:</strong> @Model.Formulario?.Version
        </p>

        <p class="mb-0">
            <strong>Fecha de inicio:</strong>
            @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")
        </p>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning" role="alert">
        @TempData["Error"]
    </div>
}

@if (!preguntas.Any())
{
    <div class="alert alert-info">
        Este formulario no tiene preguntas activas disponibles.
    </div>
}
else
{
    <p class="text-muted">
        Lee cada pregunta y selecciona la respuesta que mejor describa
        la situación actual de tu empresa. Puedes añadir observaciones
        cuando necesites aclarar tu respuesta.
    </p>

    <form asp-action="Guardar"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        @foreach (var pregunta in preguntas)
        {
            var respuesta = Model.Respuestas
                .FirstOrDefault(r => r.PreguntaId == pregunta.Id);

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Pregunta @pregunta.Orden</strong>

                    @if (pregunta.Dimension != null)
                    {
                        <span class="text-muted">
                            — @pregunta.Dimension.Nombre
                        </span>
                    }
                </div>

                <div class="card-body">
                    <p class="fw-semibold">@pregunta.Texto</p>

                    @if (!string.IsNullOrWhiteSpace(pregunta.CriterioCumplimiento))
                    {
                        <p>
                            <strong>Criterio de cumplimiento:</strong>
                            @pregunta.CriterioCumplimiento
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(pregunta.ReferenciaTecnica))
                    {
                        <p class="small text-muted">
                            <strong>Referencia técnica:</strong>
                            @pregunta.ReferenciaTecnica
                        </p>
                    }

                    <div class="mb-3">
                        <span class="form-label d-block">
                            Selecciona una respuesta:
                        </span>

                        @{
                            var opciones = pregunta.TipoRespuesta == "DosOpciones"
                                ? new[]
                                {
                                    new { Valor = 1, Texto = "Sí" },
                                    new { Valor = 3, Texto = "No" }
                                }
                                : new[]
                                {
                                    new { Valor = 1, Texto = "Sí" },
                                    new { Valor = 2, Texto = "Parcialmente" },
                                    new { Valor = 3, Texto = "No" },
                                    new { Valor = 4, Texto = "No sabe / no conoce" },
                                    new { Valor = 5, Texto = "No aplica" }
                                };
                        }

                        @foreach (var opcion in opciones)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="radio"
                                       id="valor_@(pregunta.Id)_@(opcion.Valor)"
                                       name="valor_@pregunta.Id"
                                       value="@opcion.Valor"
                                       checked="@(respuesta?.Valor == opcion.Valor)"
                                       required />

                                <label class="form-check-label"
                                       for="valor_@(pregunta.Id)_@(opcion.Valor)">
                                    @opcion.Texto
                                </label>
                            </div>
                        }
                    </div>

                    <div class="mb-2">
                        <label for="observacion_@pregunta.Id"
                               class="form-label">
                            Observaciones (opcional)
                        </label>

                        <textarea id="observacion_@pregunta.Id"
                                  name="observacion_@pregunta.Id"
                                  class="form-control"
                                  rows="2"
                                  maxlength="1000"
                                  placeholder="Agrega detalles que ayuden a explicar tu respuesta...">@respuesta?.Observaciones</textarea>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 mb-4">
            <button type="submit" class="btn btn-primary">
                Guardar respuestas
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Salir y continuar después
            </a>
        </div>
    </form>

    <div class="card border-warning">
        <div class="card-body">
            <h5 class="card-title">Finalizar evaluación</h5>

            <p>
                Antes de finalizar, guarda tus respuestas.
                Una vez finalizada, ya no podrás modificarlas desde
                este formulario.
            </p>

            <form asp-action="Finalizar"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('¿Estás seguro de finalizar esta evaluación? Verifica que hayas guardado tus respuestas.');">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="btn btn-success">
                    Finalizar evaluación
                </button>
            </form>
        </div>
    </div>
}
