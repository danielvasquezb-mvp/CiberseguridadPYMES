
@model IEnumerable<CiberseguridadPYMES.Models.Evaluacion>

@{
    ViewData["Title"] = "Mis evaluaciones";
    var evaluaciones = Model?.ToList() ?? new List<CiberseguridadPYMES.Models.Evaluacion>();
    var enProceso = evaluaciones.Count(e => e.Estado == "En proceso");
    var finalizadas = evaluaciones.Count(e => e.Estado == "Finalizada");
}

<div class="eval-page">

    <div class="eval-header">
        <div>
            <span class="eval-eyebrow">SEGUIMIENTO Y CONTROL</span>
            <h1>Mis evaluaciones</h1>
            <p>Consulta el avance de las evaluaciones de ciberseguridad de tus empresas.</p>
        </div>

        @if (User.IsInRole("Responsable del sistema"))
        {
            <a asp-action="Crear" class="btn btn-accent eval-create-btn">
                <span>＋</span> Iniciar evaluación
            </a>
        }
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert custom-alert alert-success">@TempData["Mensaje"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert custom-alert alert-warning">@TempData["Error"]</div>
    }

    <div class="eval-stats">
        <div class="eval-stat-card">
            <span class="eval-stat-icon">▤</span>
            <div>
                <span class="eval-stat-label">Total de evaluaciones</span>
                <strong>@evaluaciones.Count</strong>
            </div>
        </div>

        <div class="eval-stat-card">
            <span class="eval-stat-icon eval-icon-warning">◷</span>
            <div>
                <span class="eval-stat-label">En proceso</span>
                <strong>@enProceso</strong>
            </div>
        </div>

        <div class="eval-stat-card">
            <span class="eval-stat-icon eval-icon-success">✓</span>
            <div>
                <span class="eval-stat-label">Finalizadas</span>
                <strong>@finalizadas</strong>
            </div>
        </div>
    </div>

    <div class="eval-section-heading">
        <div>
            <h2>Historial de evaluaciones</h2>
            <span>Registro de procesos iniciados</span>
        </div>
        <span class="eval-counter">@evaluaciones.Count registros</span>
    </div>

    @if (evaluaciones.Any())
    {
        <div class="eval-table-wrapper">
            <div class="table-responsive">
                <table class="table eval-table align-middle">
                    <thead>
                        <tr>
                            <th>Empresa y formulario</th>
                            <th>Fecha de inicio</th>
                            <th>Finalización</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evaluacion in evaluaciones)
                        {
                            <tr>
                                <td>
                                    <div class="eval-company-cell">
                                        <div class="eval-company-icon">▦</div>
                                        <div>
                                            <strong>@evaluacion.Empresa?.Nombre</strong>
                                            <span>@evaluacion.Formulario?.Nombre</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="eval-date">
                                        @evaluacion.FechaInicio.ToString("dd/MM/yyyy")
                                    </span>
                                    <small class="eval-time">
                                        @evaluacion.FechaInicio.ToString("HH:mm")
                                    </small>
                                </td>
                                <td>
                                    @if (evaluacion.FechaFinalizacion.HasValue)
                                    {
                                        <span class="eval-date">
                                            @evaluacion.FechaFinalizacion.Value.ToString("dd/MM/yyyy")
                                        </span>
                                        <small class="eval-time">
                                            @evaluacion.FechaFinalizacion.Value.ToString("HH:mm")
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="eval-pending-date">Pendiente</span>
                                    }
                                </td>
                                <td>
                                    @if (evaluacion.Estado == "En proceso")
                                    {
                                        <span class="eval-status status-progress">
                                            <span></span> En proceso
                                        </span>
                                    }
                                    else if (evaluacion.Estado == "Finalizada")
                                    {
                                        <span class="eval-status status-finished">
                                            <span></span> Finalizada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="eval-status status-other">
                                            @evaluacion.Estado
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="eval-actions">
                                        @if (evaluacion.Estado == "En proceso" &&
                                             User.IsInRole("Responsable del sistema"))
                                        {
                                            <a asp-action="Responder"
                                               asp-route-id="@evaluacion.Id"
                                               class="btn btn-sm btn-accent">
                                                Continuar <span>→</span>
                                            </a>
                                        }
                                        else if (evaluacion.Estado == "Finalizada" &&
                                                 User.IsInRole("Responsable del sistema"))
                                        {
                                            <form asp-controller="Diagnostico"
                                                  asp-action="Generar"
                                                  method="post">
                                                <input type="hidden"
                                                       name="evaluacionId"
                                                       value="@evaluacion.Id" />
                                                <button type="submit" class="btn btn-sm btn-diagnostic">
                                                    Generar diagnóstico
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="eval-no-action">Sin acciones</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="eval-empty-state">
            <div class="eval-empty-icon">▤</div>
            <h3>Aún no tienes evaluaciones</h3>
            <p>Cuando inicies una evaluación, podrás consultar aquí su estado y progreso.</p>
            @if (User.IsInRole("Responsable del sistema"))
            {
                <a asp-action="Crear" class="btn btn-accent">Iniciar mi primera evaluación</a>
            }
        </div>
    }
</div>
