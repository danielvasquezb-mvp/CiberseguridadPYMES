@model IEnumerable<CiberseguridadPYMES.Models.Pregunta>

@{
    ViewData["Title"] = "Gestión de preguntas";

    var preguntas = Model.ToList();
    int total = preguntas.Count;
    int activas = preguntas.Count(p => p.Activa);
    int inactivas = total - activas;
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN / CONTENIDO</span>
            <h1 class="page-title">Gestión de preguntas</h1>
            <p class="page-description">
                Administra las preguntas que componen los formularios de evaluación.
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Crear" class="btn-question-primary">
                <i class="bi bi-plus-lg"></i>
                Registrar pregunta
            </a>
        }
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="question-alert success">
            <i class="bi bi-check-circle"></i>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="question-alert warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="question-stats">
        <div class="question-stat-card">
            <div class="question-stat-icon violet">
                <i class="bi bi-list-check"></i>
            </div>
            <div>
                <span>Total de preguntas</span>
                <strong>@total</strong>
            </div>
        </div>

        <div class="question-stat-card">
            <div class="question-stat-icon green">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <span>Preguntas activas</span>
                <strong>@activas</strong>
            </div>
        </div>

        <div class="question-stat-card">
            <div class="question-stat-icon gray">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <span>Preguntas inactivas</span>
                <strong>@inactivas</strong>
            </div>
        </div>
    </div>

    <div class="question-table-card">
        <div class="question-table-header">
            <div>
                <h5>Listado de preguntas</h5>
                <p>Preguntas registradas en los formularios del sistema.</p>
            </div>

            <div class="question-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="buscarPregunta"
                       placeholder="Buscar pregunta..." />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table question-table">
                <thead>
                    <tr>
                        <th>Orden</th>
                        <th>Pregunta</th>
                        <th>Formulario</th>
                        <th>Dimensión</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaPreguntas">
                    @foreach (var pregunta in preguntas)
                    {
                        <tr>
                            <td>
                                <span class="question-order">
                                    @pregunta.Orden
                                </span>
                            </td>

                            <td>
                                <div class="question-text-cell">
                                    <strong>@pregunta.Texto</strong>
                                    <small>Pregunta #@pregunta.Id</small>
                                </div>
                            </td>

                            <td>
                                <span class="question-secondary">
                                    @pregunta.Formulario?.Nombre
                                </span>
                            </td>

                            <td>
                                <span class="question-dimension">
                                    @pregunta.Dimension?.Nombre
                                </span>
                            </td>

                            <td>
                                @if (pregunta.Activa)
                                {
                                    <span class="question-status active">
                                        <span></span> Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="question-status inactive">
                                        <span></span> Inactiva
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="question-actions">
                                    <a asp-action="Detalles"
                                       asp-route-id="@pregunta.Id"
                                       class="question-action view"
                                       title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Editar"
                                           asp-route-id="@pregunta.Id"
                                           class="question-action edit"
                                           title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Eliminar"
                                           asp-route-id="@pregunta.Id"
                                           class="question-action delete"
                                           title="Eliminar">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="sinResultadosPreguntas" class="question-no-results" hidden>
            <i class="bi bi-search"></i>
            <p>No se encontraron preguntas con ese término.</p>
        </div>

        @if (!preguntas.Any())
        {
            <div class="question-empty">
                <i class="bi bi-clipboard-x"></i>
                <h5>No hay preguntas registradas</h5>
                <p>Cuando registres preguntas, aparecerán en este listado.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const buscadorPreguntas = document.getElementById("buscarPregunta");
        const filasPreguntas = document.querySelectorAll("#tablaPreguntas tr");
        const sinResultados = document.getElementById("sinResultadosPreguntas");

        buscadorPreguntas?.addEventListener("input", function () {
            const termino = this.value.toLowerCase().trim();
            let visibles = 0;

            filasPreguntas.forEach(fila => {
                const coincide = fila.textContent.toLowerCase().includes(termino);
                fila.style.display = coincide ? "" : "none";

                if (coincide) visibles++;
            });

            sinResultados.hidden = visibles !== 0;
        });
    </script>
}