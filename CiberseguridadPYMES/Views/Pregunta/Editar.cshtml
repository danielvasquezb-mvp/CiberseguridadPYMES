
@model CiberseguridadPYMES.Models.Pregunta

@{
    ViewData["Title"] = "Editar pregunta";
}

<h1>Editar pregunta</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Editar"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="formularioId" class="form-label">
                    Formulario
                </label>

                <select id="formularioId"
                        name="formularioId"
                        class="form-select"
                        asp-items="ViewBag.Formularios"
                        required>
                    <option value="">Seleccione un formulario</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="dimensionId" class="form-label">
                    Dimensión de ciberseguridad
                </label>

                <select id="dimensionId"
                        name="dimensionId"
                        class="form-select"
                        asp-items="ViewBag.Dimensiones"
                        required>
                    <option value="">Seleccione una dimensión</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="texto" class="form-label">
                    Texto de la pregunta
                </label>

                <textarea id="texto"
                          name="texto"
                          class="form-control"
                          rows="3"
                          maxlength="1000"
                          required>@Model.Texto</textarea>
            </div>

            <div class="mb-3">
                <label for="referenciaTecnica" class="form-label">
                    Referencia técnica
                </label>

                <input id="referenciaTecnica"
                       name="referenciaTecnica"
                       class="form-control"
                       maxlength="300"
                       value="@Model.ReferenciaTecnica" />
            </div>

            <div class="mb-3">
                <label for="criterioCumplimiento" class="form-label">
                    Criterio de cumplimiento
                </label>

                <textarea id="criterioCumplimiento"
                          name="criterioCumplimiento"
                          class="form-control"
                          rows="3"
                          maxlength="1000">@Model.CriterioCumplimiento</textarea>
            </div>

            <div class="mb-3">
                <label for="tipoRespuesta" class="form-label">
                    Tipo de respuesta
                </label>

                <select id="tipoRespuesta"
                        name="tipoRespuesta"
                        class="form-select"
                        required>

                    @if (Model.TipoRespuesta == "DosOpciones")
                    {
                        <option value="DosOpciones" selected>
                            Dos opciones (Sí / No)
                        </option>
                        <option value="CincoOpciones">
                            Cinco opciones
                        </option>
                    }
                    else
                    {
                        <option value="DosOpciones">
                            Dos opciones (Sí / No)
                        </option>
                        <option value="CincoOpciones" selected>
                            Cinco opciones
                        </option>
                    }
                </select>

                <div class="form-text">
                    Dos opciones: Sí y No.
                    Cinco opciones: Sí, Parcialmente, No,
                    No sabe/no conoce y No aplica.
                </div>
            </div>

            <div class="mb-3">
                <label for="orden" class="form-label">
                    Orden de presentación
                </label>

                <input id="orden"
                       name="orden"
                       type="number"
                       class="form-control"
                       min="1"
                       value="@Model.Orden"
                       required />
            </div>

            <div class="form-check mb-3">
                @if (Model.Activa)
                {
                    <input id="activa"
                           name="activa"
                           type="checkbox"
                           value="true"
                           class="form-check-input"
                           checked />
                }
                else
                {
                    <input id="activa"
                           name="activa"
                           type="checkbox"
                           value="true"
                           class="form-check-input" />
                }

                <input type="hidden" name="activa" value="false" />

                <label for="activa" class="form-check-label">
                    Pregunta activa
                </label>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
        </form>
    </div>
</div>
