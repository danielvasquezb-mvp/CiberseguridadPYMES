@model CiberseguridadPYMES.Models.Pregunta

@{
    ViewData["Title"] = "Editar pregunta";

    var recomendaciones = Model.Recomendaciones?.ToList()
        ?? new List<CiberseguridadPYMES.Models.Recomendacion>();
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN / PREGUNTAS</span>
            <h1 class="page-title">Editar pregunta</h1>
            <p class="page-description">
                Actualiza la pregunta y administra sus recomendaciones asociadas.
            </p>
        </div>

        <a asp-action="Index" class="btn-question-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <form asp-action="Editar" asp-route-id="@Model.Id"
          method="post" id="formEditarPregunta">

        <input type="hidden" name="id" value="@Model.Id" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="question-validation"></div>
        }

        <div class="question-form-card">
            <div class="question-form-heading">
                <div class="question-form-icon violet">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h5>Información de la pregunta</h5>
                    <p>Modifica los datos de configuración.</p>
                </div>
            </div>

            <div class="question-form-grid">
                <div class="question-field">
                    <label for="formularioId">Formulario</label>
                    <select id="formularioId" name="formularioId"
                            class="form-select" asp-items="ViewBag.Formularios" required>
                        <option value="">Seleccione un formulario</option>
                    </select>
                </div>

                <div class="question-field">
                    <label for="dimensionId">Dimensión de ciberseguridad</label>
                    <select id="dimensionId" name="dimensionId"
                            class="form-select" asp-items="ViewBag.Dimensiones" required>
                        <option value="">Seleccione una dimensión</option>
                    </select>
                </div>

                <div class="question-field full">
                    <label for="texto">Texto de la pregunta</label>
                    <textarea id="texto" name="texto" class="form-control"
                              rows="3" maxlength="1000" required>@Model.Texto</textarea>
                </div>

                <div class="question-field">
                    <label for="referenciaTecnica">Referencia técnica</label>
                    <input id="referenciaTecnica" name="referenciaTecnica"
                           class="form-control" maxlength="300"
                           value="@Model.ReferenciaTecnica" />
                </div>

                <div class="question-field">
                    <label for="orden">Orden de presentación</label>
                    <input id="orden" name="orden" type="number"
                           class="form-control" min="1"
                           value="@Model.Orden" required />
                </div>

                <div class="question-field full">
                    <label for="criterioCumplimiento">Criterio de cumplimiento</label>
                    <textarea id="criterioCumplimiento" name="criterioCumplimiento"
                              class="form-control" rows="3"
                              maxlength="1000">@Model.CriterioCumplimiento</textarea>
                </div>

                <div class="question-field">
                    <label for="tipoRespuesta">Tipo de respuesta</label>
                    <select id="tipoRespuesta" name="tipoRespuesta"
                            class="form-select" required>
                        <option value="DosOpciones"
                                selected="@(Model.TipoRespuesta == "DosOpciones")">
                            Dos opciones (Sí / No)
                        </option>
                        <option value="CincoOpciones"
                                selected="@(Model.TipoRespuesta == "CincoOpciones")">
                            Cinco opciones
                        </option>
                    </select>
                    <small>
                        Cinco opciones incluye Sí, Parcialmente, No,
                        No sabe/no conoce y No aplica.
                    </small>
                </div>

                <div class="question-field">
                    <label>Estado de la pregunta</label>
                    <label class="question-switch">
                        <input id="activa" name="activa" type="checkbox"
                               value="true" checked="@Model.Activa" />
                        <span class="question-switch-slider"></span>
                        <span>Pregunta activa</span>
                    </label>
                    <input type="hidden" name="activa" value="false" />
                </div>
            </div>
        </div>

        <div class="question-form-card">
            <div class="question-form-heading">
                <div class="question-form-icon green">
                    <i class="bi bi-lightbulb"></i>
                </div>
                <div>
                    <h5>Recomendaciones asociadas</h5>
                    <p>Administra las acciones de mejora de esta pregunta.</p>
                </div>

                <button type="button" class="btn-question-outline"
                        id="agregarRecomendacion">
                    <i class="bi bi-plus-lg"></i> Agregar
                </button>
            </div>

            <div id="contenedorRecomendaciones">
                @for (int i = 0; i < recomendaciones.Count; i++)
                {
                    <div class="question-recommendation-item">
                        <input type="hidden"
                               name="recomendaciones[@i].Id"
                               value="@recomendaciones[i].Id" />

                        <div class="question-recommendation-top">
                            <span><i class="bi bi-lightbulb"></i> Recomendación</span>
                            <button type="button" class="question-remove-recommendation">
                                <i class="bi bi-trash3"></i> Quitar
                            </button>
                        </div>

                        <div class="question-form-grid">
                            <div class="question-field full">
                                <label>Título</label>
                                <input name="recomendaciones[@i].Titulo"
                                       class="form-control" maxlength="200"
                                       value="@recomendaciones[i].Titulo" />
                            </div>

                            <div class="question-field full">
                                <label>Descripción</label>
                                <textarea name="recomendaciones[@i].Descripcion"
                                          class="form-control" rows="3"
                                          maxlength="1000">@recomendaciones[i].Descripcion</textarea>
                            </div>

                            <div class="question-field">
                                <label>Prioridad</label>
                                <select name="recomendaciones[@i].Prioridad"
                                        class="form-select">
                                    <option value="Alta" selected="@(recomendaciones[i].Prioridad == "Alta")">Alta</option>
                                    <option value="Media" selected="@(recomendaciones[i].Prioridad == "Media")">Media</option>
                                    <option value="Baja" selected="@(recomendaciones[i].Prioridad == "Baja")">Baja</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div id="recomendacionesVacias" class="question-recommendation-empty"
                 hidden>
                <i class="bi bi-lightbulb"></i>
                <span>No hay recomendaciones asociadas.</span>
            </div>
        </div>

        <div class="question-form-actions">
            <a asp-action="Index" class="btn-question-secondary">Cancelar</a>
            <button type="submit" class="btn-question-primary">
                <i class="bi bi-check-lg"></i> Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const contenedor = document.getElementById("contenedorRecomendaciones");
        const botonAgregar = document.getElementById("agregarRecomendacion");
        const recomendacionesVacias = document.getElementById("recomendacionesVacias");

        function reindexarRecomendaciones() {
            const tarjetas = contenedor.querySelectorAll(".question-recommendation-item");

            tarjetas.forEach((tarjeta, indice) => {
                tarjeta.querySelectorAll("[name]").forEach(campo => {
                    campo.name = campo.name.replace(
                        /recomendaciones\[\d+\]/g,
                        `recomendaciones[${indice}]`
                    );
                });
            });

            recomendacionesVacias.hidden = tarjetas.length > 0;
        }

        botonAgregar.addEventListener("click", function () {
            const tarjeta = document.createElement("div");
            tarjeta.className = "question-recommendation-item";

            tarjeta.innerHTML = `
                <input type="hidden" name="recomendaciones[0].Id" value="0" />
                <div class="question-recommendation-top">
                    <span><i class="bi bi-lightbulb"></i> Nueva recomendación</span>
                    <button type="button" class="question-remove-recommendation">
                        <i class="bi bi-trash3"></i> Quitar
                    </button>
                </div>
                <div class="question-form-grid">
                    <div class="question-field full">
                        <label>Título</label>
                        <input name="recomendaciones[0].Titulo"
                               class="form-control" maxlength="200" />
                    </div>
                    <div class="question-field full">
                        <label>Descripción</label>
                        <textarea name="recomendaciones[0].Descripcion"
                                  class="form-control" rows="3"
                                  maxlength="1000"></textarea>
                    </div>
                    <div class="question-field">
                        <label>Prioridad</label>
                        <select name="recomendaciones[0].Prioridad" class="form-select">
                            <option value="Alta">Alta</option>
                            <option value="Media" selected>Media</option>
                            <option value="Baja">Baja</option>
                        </select>
                    </div>
                </div>`;

            contenedor.appendChild(tarjeta);
            reindexarRecomendaciones();
        });

        contenedor.addEventListener("click", function (evento) {
            const boton = evento.target.closest(".question-remove-recommendation");

            if (boton) {
                boton.closest(".question-recommendation-item").remove();
                reindexarRecomendaciones();
            }
        });

        reindexarRecomendaciones();
    </script>
}