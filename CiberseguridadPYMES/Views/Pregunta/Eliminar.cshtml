@model CiberseguridadPYMES.Models.Pregunta

@{
    ViewData["Title"] = "Eliminar pregunta";
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN / PREGUNTAS</span>
            <h1 class="page-title">Eliminar pregunta</h1>
            <p class="page-description">
                Revisa la información antes de confirmar esta operación.
            </p>
        </div>
    </div>

    <div class="question-delete-card">

        <div class="question-delete-heading">
            <div class="question-delete-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>
                <h4>¿Deseas eliminar esta pregunta?</h4>
                <p>
                    Esta acción puede afectar la información relacionada con la pregunta.
                </p>
            </div>
        </div>

        <div class="question-delete-warning">
            <i class="bi bi-info-circle"></i>
            <span>
                Si la pregunta tiene respuestas históricas o recomendaciones
                relacionadas, la base de datos puede impedir su eliminación.
            </span>
        </div>

        <div class="question-delete-info">
            <div>
                <span>Formulario</span>
                <strong>@Model.Formulario?.Nombre</strong>
            </div>

            <div>
                <span>Dimensión</span>
                <strong>@Model.Dimension?.Nombre</strong>
            </div>

            <div>
                <span>Orden</span>
                <strong>@Model.Orden</strong>
            </div>

            <div class="full">
                <span>Texto de la pregunta</span>
                <strong>@Model.Texto</strong>
            </div>
        </div>

        <form asp-action="Eliminar"
              asp-route-id="@Model.Id"
              method="post"
              class="question-delete-actions">

            <input type="hidden" name="id" value="@Model.Id" />

            <a asp-action="Index" class="btn-question-secondary">
                Cancelar
            </a>

            <button type="submit" class="btn-question-danger">
                <i class="bi bi-trash3"></i> Confirmar eliminación
            </button>
        </form>
    </div>
</div>