@model CiberseguridadPYMES.Models.Pregunta

@{
    ViewData["Title"] = "Detalles de la pregunta";
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN / PREGUNTAS</span>
            <h1 class="page-title">Detalles de la pregunta</h1>
            <p class="page-description">
                Consulta la información y los criterios de esta pregunta.
            </p>
        </div>

        <a asp-action="Index" class="btn-question-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="question-detail-card">

        <div class="question-detail-heading">
            <div class="question-form-icon violet">
                <i class="bi bi-card-text"></i>
            </div>

            <div>
                <span class="question-detail-label">PREGUNTA #@Model.Id</span>
                <h4>Información general</h4>
            </div>

            <div class="ms-auto">
                @if (Model.Activa)
                {
                    <span class="question-status active">
                        <span></span> Activa
                    </span>
                }
                else
                {
                    <span class="question-status inactive">
                        <span></span> Inactiva
                    </span>
                }
            </div>
        </div>

        <div class="question-detail-content">
            <div class="question-detail-item">
                <span>Formulario</span>
                <strong>@Model.Formulario?.Nombre</strong>
            </div>

            <div class="question-detail-item">
                <span>Dimensión de ciberseguridad</span>
                <strong>@Model.Dimension?.Nombre</strong>
            </div>

            <div class="question-detail-item">
                <span>Orden de presentación</span>
                <strong>@Model.Orden</strong>
            </div>

            <div class="question-detail-item">
                <span>Tipo de respuesta</span>
                <strong>
                    @(Model.TipoRespuesta == "DosOpciones"
                        ? "Dos opciones (Sí / No)"
                        : "Cinco opciones")
                </strong>
            </div>

            <div class="question-detail-item full">
                <span>Texto de la pregunta</span>
                <p>@Model.Texto</p>
            </div>

            <div class="question-detail-item full">
                <span>Referencia técnica</span>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.ReferenciaTecnica)
                        ? "No especificada"
                        : Model.ReferenciaTecnica)
                </p>
            </div>

            <div class="question-detail-item full">
                <span>Criterio de cumplimiento</span>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.CriterioCumplimiento)
                        ? "No especificado"
                        : Model.CriterioCumplimiento)
                </p>
            </div>
        </div>

        <div class="question-detail-footer">
            <a asp-action="Index" class="btn-question-secondary">
                Volver al listado
            </a>

            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Editar"
                   asp-route-id="@Model.Id"
                   class="btn-question-primary">
                    <i class="bi bi-pencil-square"></i> Editar pregunta
                </a>
            }
        </div>
    </div>
</div>