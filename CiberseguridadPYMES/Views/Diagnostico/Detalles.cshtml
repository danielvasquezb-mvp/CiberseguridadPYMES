
@model CiberseguridadPYMES.Models.Diagnostico

@{
    ViewData["Title"] = "Detalle del diagnóstico";

    var resultados = Model.ResultadosDimension
        .OrderBy(r => r.Dimension?.Codigo)
        .ToList();

    var hallazgos = Model.Hallazgos
        .OrderByDescending(h =>
            h.Prioridad == "Alta" ? 3 :
            h.Prioridad == "Media" ? 2 : 1)
        .ToList();

    int totalHallazgos = hallazgos.Count;
    int hallazgosAltos = hallazgos.Count(h => h.Prioridad == "Alta");
    int hallazgosMedios = hallazgos.Count(h => h.Prioridad == "Media");
    int hallazgosBajos = hallazgos.Count(h => h.Prioridad == "Baja");

    decimal porcentajeGeneral = Math.Clamp(Model.PorcentajeGeneral, 0m, 100m);

    string ObtenerClasePrioridad(string? prioridad)
    {
        return prioridad switch
        {
            "Alta" => "diagnostic-priority-high",
            "Media" => "diagnostic-priority-medium",
            "Baja" => "diagnostic-priority-low",
            _ => "diagnostic-priority-default"
        };
    }

    string ObtenerTextoCumplimiento(decimal porcentaje)
    {
        if (porcentaje >= 80) return "Nivel alto";
        if (porcentaje >= 60) return "Nivel moderado";
        if (porcentaje >= 40) return "Nivel básico";
        return "Requiere atención";
    }
}

<div class="diagnostic-page">

    <!-- Encabezado -->
    <div class="diagnostic-breadcrumb">
        <a asp-controller="Evaluacion" asp-action="Index">Mis evaluaciones</a>
        <span>/</span>
        <span>Diagnóstico</span>
    </div>

    <div class="diagnostic-header">
        <div>
            <span class="diagnostic-eyebrow">ANÁLISIS DE CIBERSEGURIDAD</span>
            <h1>Diagnóstico de ciberseguridad</h1>
            <p>
                Consulta el nivel de cumplimiento, las brechas identificadas
                y las oportunidades de mejora de tu empresa.
            </p>
        </div>

        <div class="diagnostic-header-icon">◈</div>
    </div>

    <!-- Mensajes -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="diagnostic-alert diagnostic-alert-success">
            <span>✓</span>
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="diagnostic-alert diagnostic-alert-danger">
            <span>!</span>
            @TempData["Error"]
        </div>
    }

    <!-- Información de evaluación -->
    <section class="diagnostic-info-card">
        <div class="diagnostic-section-heading">
            <div class="diagnostic-section-icon">▤</div>
            <div>
                <h2>Información de la evaluación</h2>
                <p>Datos generales del proceso evaluado.</p>
            </div>
            <span class="diagnostic-status">Finalizada</span>
        </div>

        <div class="diagnostic-info-grid">
            <div class="diagnostic-info-item">
                <span>EMPRESA</span>
                <strong>@(Model.Evaluacion?.Empresa?.Nombre ?? "No disponible")</strong>
            </div>

            <div class="diagnostic-info-item">
                <span>FORMULARIO</span>
                <strong>@(Model.Evaluacion?.Formulario?.Nombre ?? "No disponible")</strong>
            </div>

            <div class="diagnostic-info-item">
                <span>FECHA DE GENERACIÓN</span>
                <strong>@Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>

            <div class="diagnostic-info-item">
                <span>ESTADO</span>
                <strong class="diagnostic-finished">● Proceso finalizado</strong>
            </div>
        </div>
    </section>

    <!-- Resumen -->
    <div class="diagnostic-section-title">
        <span class="diagnostic-eyebrow">VISTA GENERAL</span>
        <h2>Resumen del diagnóstico</h2>
        <p>Indicadores principales del resultado de la autoevaluación.</p>
    </div>

    <div class="diagnostic-summary-grid">

        <!-- Cumplimiento -->
        <section class="diagnostic-score-card">
            <div class="diagnostic-card-top">
                <div>
                    <span class="diagnostic-card-label">CUMPLIMIENTO GENERAL</span>
                    <h3>Nivel de cumplimiento</h3>
                </div>
                <div class="diagnostic-card-icon score-icon">◉</div>
            </div>

            <div class="diagnostic-score-value">
                <strong>@Model.PorcentajeGeneral.ToString("0.##")</strong>
                <span>%</span>
            </div>

            <div class="diagnostic-progress-track">
                <div class="diagnostic-progress-fill"
                     style="width: @porcentajeGeneral.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                </div>
            </div>

            <div class="diagnostic-score-footer">
                <span>@ObtenerTextoCumplimiento(Model.PorcentajeGeneral)</span>
                <span>100% máximo</span>
            </div>

            <p class="diagnostic-card-note">
                El cálculo excluye las respuestas marcadas como No aplica.
            </p>
        </section>

        <!-- Hallazgos -->
        <section class="diagnostic-findings-card">
            <div class="diagnostic-card-top">
                <div>
                    <span class="diagnostic-card-label">BRECHAS IDENTIFICADAS</span>
                    <h3>Hallazgos detectados</h3>
                </div>
                <div class="diagnostic-card-icon findings-icon">⌕</div>
            </div>

            <div class="diagnostic-findings-total">
                <strong>@totalHallazgos</strong>
                <span>hallazgos</span>
            </div>

            <div class="diagnostic-priority-summary">
                <div>
                    <span class="priority-dot priority-dot-high"></span>
                    <span>Alta</span>
                    <strong>@hallazgosAltos</strong>
                </div>
                <div>
                    <span class="priority-dot priority-dot-medium"></span>
                    <span>Media</span>
                    <strong>@hallazgosMedios</strong>
                </div>
                <div>
                    <span class="priority-dot priority-dot-low"></span>
                    <span>Baja</span>
                    <strong>@hallazgosBajos</strong>
                </div>
            </div>

            <p class="diagnostic-card-note">
                Distribución de hallazgos según su nivel de prioridad.
            </p>
        </section>
    </div>

    <!-- Interpretación -->
    <section class="diagnostic-interpretation">
        <div class="diagnostic-interpretation-icon">i</div>
        <div>
            <span class="diagnostic-eyebrow">INTERPRETACIÓN</span>
            <h3>Resultado de la evaluación</h3>
            <p>@Model.Resumen</p>

            @if (resultados.Any() && resultados.All(r => r.PreguntasAplicables == 0))
            {
                <div class="diagnostic-warning">
                    <strong>Atención:</strong> Todas las preguntas se marcaron como
                    No aplica. No existe una base aplicable para interpretar el
                    porcentaje como una medida efectiva de cumplimiento.
                </div>
            }
        </div>
    </section>

    <!-- Resultados por dimensión -->
    <div class="diagnostic-section-title">
        <span class="diagnostic-eyebrow">ANÁLISIS DETALLADO</span>
        <h2>Cumplimiento por dimensión</h2>
        <p>Consulta los resultados individuales de cada área de ciberseguridad.</p>
    </div>

    @if (resultados.Any())
    {
        <section class="diagnostic-dimensions-grid">
            @foreach (var resultado in resultados)
            {
                var porcentaje = Math.Clamp(
                    resultado.PorcentajeCumplimiento, 0m, 100m);

                <article class="diagnostic-dimension-card">
                    <div class="diagnostic-dimension-top">
                        <span class="diagnostic-dimension-code">
                            @(resultado.Dimension?.Codigo ?? "DIM")
                        </span>

                        @if (resultado.PreguntasAplicables == 0)
                        {
                            <span class="diagnostic-no-data">Sin datos</span>
                        }
                        else
                        {
                            <span class="diagnostic-dimension-percentage">
                                @resultado.PorcentajeCumplimiento.ToString("0.##")%
                            </span>
                        }
                    </div>

                    <h3>
                        @(resultado.Dimension?.Nombre ?? "Dimensión no disponible")
                    </h3>

                    <div class="diagnostic-dimension-progress">
                        <div style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                        </div>
                    </div>

                    <div class="diagnostic-dimension-stats">
                        <span>
                            <strong>@resultado.PreguntasCumplidas</strong>
                            cumplidas
                        </span>
                        <span>
                            <strong>@resultado.PreguntasAplicables</strong>
                            aplicables
                        </span>
                    </div>

                    @if (resultado.PreguntasAplicables == 0)
                    {
                        <p class="diagnostic-dimension-note">
                            No hay preguntas aplicables para esta dimensión.
                        </p>
                    }
                </article>
            }
        </section>
    }
    else
    {
        <div class="diagnostic-empty">
            No hay resultados por dimensión disponibles.
        </div>
    }

    <!-- Hallazgos y recomendaciones -->
    <div class="diagnostic-section-title diagnostic-findings-heading">
        <span class="diagnostic-eyebrow">OPORTUNIDADES DE MEJORA</span>
        <h2>Hallazgos y recomendaciones</h2>
        <p>
            Revisa cada hallazgo para conocer la pregunta relacionada,
            la brecha identificada y las acciones recomendadas.
        </p>
    </div>

    @if (hallazgos.Any())
    {
        <div class="diagnostic-accordion" id="acordeonHallazgos">
            @for (int i = 0; i < hallazgos.Count; i++)
            {
                var hallazgo = hallazgos[i];
                var contenidoId = $"contenidoHallazgo{i}";
                var prioridadClase = ObtenerClasePrioridad(hallazgo.Prioridad);

                <article class="diagnostic-finding-item">

                    <button class="diagnostic-finding-trigger"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@contenidoId"
                            aria-expanded="false"
                            aria-controls="@contenidoId">

                        <div class="diagnostic-finding-number">
                            @((i + 1).ToString("00"))
                        </div>

                        <div class="diagnostic-finding-main">
                            <span class="diagnostic-finding-dimension">
                                @(hallazgo.Pregunta?.Dimension?.Nombre ?? "Dimensión no disponible")
                            </span>

                            <strong>
                                @(hallazgo.Pregunta?.Texto ?? "Pregunta no disponible")
                            </strong>
                        </div>

                        <span class="diagnostic-priority @prioridadClase">
                            @hallazgo.Prioridad
                        </span>

                        <span class="diagnostic-chevron">⌄</span>
                    </button>

                    <div id="@contenidoId"
                         class="collapse"
                         data-bs-parent="#acordeonHallazgos">

                        <div class="diagnostic-finding-body">

                            <div class="diagnostic-finding-description">
                                <span class="diagnostic-detail-label">
                                    DESCRIPCIÓN DEL HALLAZGO
                                </span>
                                <p>@hallazgo.Descripcion</p>
                            </div>

                            <div class="diagnostic-recommendations-heading">
                                <div class="diagnostic-recommendation-icon">✧</div>
                                <div>
                                    <h4>Recomendaciones de mejora</h4>
                                    <p>Acciones sugeridas para atender esta brecha.</p>
                                </div>
                            </div>

                            @if (hallazgo.Pregunta?.Recomendaciones != null &&
                                 hallazgo.Pregunta.Recomendaciones.Any(r => r.Activa))
                            {
                                var recomendaciones = hallazgo.Pregunta.Recomendaciones
                                    .Where(r => r.Activa)
                                    .OrderBy(r =>
                                        r.Prioridad == "Alta" ? 1 :
                                        r.Prioridad == "Media" ? 2 : 3)
                                    .ToList();

                                <div class="diagnostic-recommendations-list">
                                    @foreach (var recomendacion in recomendaciones)
                                    {
                                        <div class="diagnostic-recommendation">
                                            <div class="diagnostic-recommendation-marker">✓</div>
                                            <div>
                                                <div class="diagnostic-recommendation-title">
                                                    <h5>@recomendacion.Titulo</h5>
                                                    <span class="diagnostic-priority @ObtenerClasePrioridad(recomendacion.Prioridad)">
                                                        @recomendacion.Prioridad
                                                    </span>
                                                </div>
                                                <p>@recomendacion.Descripcion</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="diagnostic-no-recommendations">
                                    No hay recomendaciones activas registradas para esta pregunta.
                                </div>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="diagnostic-no-findings">
            <div class="diagnostic-no-findings-icon">✓</div>
            <h3>No se identificaron hallazgos</h3>
            <p>
                Según las respuestas registradas, no se generaron hallazgos
                para esta evaluación.
            </p>
        </div>
    }

    <!-- Acción final -->
<div class="diagnostic-bottom-actions">

    <a asp-controller="Evaluacion"
       asp-action="Index"
       class="btn btn-outline-light">
        <i class="bi bi-arrow-left"></i>
        Volver a evaluaciones
    </a>

    <a asp-controller="Diagnostico"
       asp-action="DescargarPdf"
       asp-route-id="@Model.Id"
       class="diagnostic-download-btn">
        <i class="bi bi-file-earmark-pdf"></i>
        Descargar diagnóstico PDF
    </a>

</div>
    

</div>
