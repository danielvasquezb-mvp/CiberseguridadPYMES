
@model IEnumerable<CiberseguridadPYMES.Models.Diagnostico>

@{
    ViewData["Title"] = "Diagnósticos";

    var diagnosticos = Model
        .OrderByDescending(d => d.FechaGeneracion)
        .ToList();

    int totalDiagnosticos = diagnosticos.Count;

    decimal promedioCumplimiento = diagnosticos.Any()
        ? diagnosticos.Average(d => d.PorcentajeGeneral)
        : 0m;

    int diagnosticosConHallazgos = diagnosticos.Count(d =>
        d.Hallazgos != null && d.Hallazgos.Any());

    decimal promedioLimitado = Math.Clamp(promedioCumplimiento, 0m, 100m);
}

<div class="diagnostic-page">

    <!-- Encabezado -->
    <div class="diagnostic-breadcrumb">
        <a asp-controller="Evaluacion" asp-action="Index">Mis evaluaciones</a>
        <span>/</span>
        <span>Diagnósticos</span>
    </div>

    <div class="diagnostic-header">
        <div>
            <span class="diagnostic-eyebrow">CENTRO DE RESULTADOS</span>
            <h1>Mis diagnósticos</h1>
            <p>
                Consulta el historial y los resultados de tus evaluaciones
                de ciberseguridad.
            </p>
        </div>

        <div class="diagnostic-header-icon">◈</div>
    </div>

    <!-- Mensajes -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="diagnostic-alert diagnostic-alert-success">
            <span>✓</span>
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="diagnostic-alert diagnostic-alert-danger">
            <span>!</span>
            @TempData["Error"]
        </div>
    }

    <!-- Indicadores -->
    <div class="diagnostic-section-title">
        <span class="diagnostic-eyebrow">RESUMEN</span>
        <h2>Indicadores generales</h2>
        <p>Resumen de los diagnósticos asociados a tu cuenta.</p>
    </div>

    <div class="diagnostic-summary-grid">

        <section class="diagnostic-score-card">
            <div class="diagnostic-card-top">
                <div>
                    <span class="diagnostic-card-label">HISTORIAL</span>
                    <h3>Diagnósticos generados</h3>
                </div>
                <div class="diagnostic-card-icon score-icon">▤</div>
            </div>

            <div class="diagnostic-history-value">
                <strong>@totalDiagnosticos</strong>
                <span>registros</span>
            </div>

            <p class="diagnostic-card-note">
                Total de resultados disponibles para consulta.
            </p>
        </section>

        <section class="diagnostic-score-card">
            <div class="diagnostic-card-top">
                <div>
                    <span class="diagnostic-card-label">RESULTADO PROMEDIO</span>
                    <h3>Promedio de cumplimiento</h3>
                </div>
                <div class="diagnostic-card-icon findings-icon">◉</div>
            </div>

            <div class="diagnostic-history-value">
                @if (diagnosticos.Any())
                {
                    <strong>@promedioCumplimiento.ToString("0.##")</strong>
                    <span>%</span>
                }
                else
                {
                    <strong>—</strong>
                }
            </div>

            @if (diagnosticos.Any())
            {
                <div class="diagnostic-progress-track">
                    <div class="diagnostic-progress-fill"
                         style="width: @promedioLimitado.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                    </div>
                </div>
            }

            <p class="diagnostic-card-note">
                Promedio de cumplimiento de todos tus diagnósticos.
            </p>
        </section>

    </div>

    <!-- Historial -->
    <div class="diagnostic-history-heading">
        <div>
            <span class="diagnostic-eyebrow">REGISTROS</span>
            <h2>Historial de diagnósticos</h2>
            <p>Selecciona un registro para consultar sus resultados detallados.</p>
        </div>

        <span class="diagnostic-history-count">
            @totalDiagnosticos @(totalDiagnosticos == 1 ? "diagnóstico" : "diagnósticos")
        </span>
    </div>

    @if (diagnosticos.Any())
    {
        <div class="diagnostic-history-table-wrapper">
            <div class="table-responsive">
                <table class="diagnostic-history-table">
                    <thead>
                        <tr>
                            <th>EMPRESA</th>
                            <th>FORMULARIO</th>
                            <th>FECHA</th>
                            <th>CUMPLIMIENTO</th>
                            <th>RESUMEN</th>
                            <th class="text-end">ACCIÓN</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var diagnostico in diagnosticos)
                        {
                            var porcentaje = Math.Clamp(
                                diagnostico.PorcentajeGeneral, 0m, 100m);

                            <tr>
                                <td>
                                    <div class="diagnostic-company-cell">
                                        <div class="diagnostic-company-icon">▦</div>
                                        <strong>
                                            @(diagnostico.Evaluacion?.Empresa?.Nombre
                                                ?? "No disponible")
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <span class="diagnostic-form-name">
                                        @(diagnostico.Evaluacion?.Formulario?.Nombre
                                            ?? "No disponible")
                                    </span>
                                </td>

                                <td>
                                    <span class="diagnostic-date">
                                        @diagnostico.FechaGeneracion.ToString("dd/MM/yyyy")
                                    </span>
                                    <small class="diagnostic-date-time">
                                        @diagnostico.FechaGeneracion.ToString("HH:mm")
                                    </small>
                                </td>

                                <td>
                                    <div class="diagnostic-table-score">
                                        <strong>
                                            @diagnostico.PorcentajeGeneral.ToString("0.##")%
                                        </strong>
                                    </div>

                                    <div class="diagnostic-table-progress">
                                        <div style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="diagnostic-table-summary"
                                          title="@diagnostico.Resumen">
                                        @diagnostico.Resumen
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Diagnostico"
                                       asp-action="Detalles"
                                       asp-route-evaluacionId="@diagnostico.EvaluacionId"
                                       class="diagnostic-view-button">
                                        Ver diagnóstico
                                        <span>→</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="diagnostic-history-empty">
            <div class="diagnostic-empty-icon">◈</div>

            <h3>Aún no tienes diagnósticos</h3>

            <p>
                Cuando finalices una evaluación y generes su diagnóstico,
                podrás consultar aquí los resultados y las recomendaciones.
            </p>

            <a asp-controller="Evaluacion"
               asp-action="Index"
               class="btn btn-accent">
                Ir a mis evaluaciones →
            </a>
        </div>
    }

    <!-- Acción inferior -->
    <div class="diagnostic-bottom-actions">
        <a asp-controller="Evaluacion"
           asp-action="Index"
           class="btn btn-outline-light">
            ← Volver a evaluaciones
        </a>
    </div>

</div>
