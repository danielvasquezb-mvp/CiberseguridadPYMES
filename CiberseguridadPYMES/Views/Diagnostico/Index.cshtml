@model IEnumerable<CiberseguridadPYMES.Models.Diagnostico>

@{
    ViewData["Title"] = "Diagnósticos";
    var diagnosticos = Model.ToList();
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1>Diagnósticos</h1>
            <p class="text-muted mb-0">
                Consulta los resultados de tus evaluaciones de ciberseguridad.
            </p>
        </div>

        <a asp-controller="Evaluacion"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Volver a evaluaciones
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <!-- Resumen -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Diagnósticos generados</h6>
                    <p class="display-5 fw-bold mb-0">
                        @diagnosticos.Count
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Promedio de cumplimiento</h6>

                    @if (diagnosticos.Any())
                    {
                        <p class="display-5 fw-bold mb-0">
                            @diagnosticos.Average(
                                d => d.PorcentajeGeneral).ToString("0.##")%
                        </p>
                    }
                    else
                    {
                        <p class="display-5 fw-bold mb-0">—</p>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- Tabla de diagnósticos -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Historial de diagnósticos</h5>
        </div>

        @if (diagnosticos.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Empresa</th>
                            <th>Formulario</th>
                            <th>Fecha de generación</th>
                            <th class="text-center">Cumplimiento</th>
                            <th>Resumen</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var diagnostico in diagnosticos)
                        {
                            <tr>
                                <td>
                                    @(diagnostico.Evaluacion?.Empresa?.Nombre
                                        ?? "No disponible")
                                </td>

                                <td>
                                    @(diagnostico.Evaluacion?.Formulario?.Nombre
                                        ?? "No disponible")
                                </td>

                                <td>
                                    @diagnostico.FechaGeneracion.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td class="text-center">
                                    <strong>
                                        @diagnostico.PorcentajeGeneral.ToString("0.##")%
                                    </strong>
                                </td>

                                <td>
                                    @diagnostico.Resumen
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Diagnostico"
                                       asp-action="Detalles"
                                       asp-route-evaluacionId="@diagnostico.EvaluacionId"
                                       class="btn btn-primary btn-sm">
                                        Ver diagnóstico
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="alert alert-info mb-0">
                    Todavía no tienes diagnósticos generados.
                    Finaliza una evaluación y genera su diagnóstico para
                    consultar los resultados aquí.
                </div>
            </div>
        }

    </div>

</div>
