@model CiberseguridadPYMES.Models.Empresa

@{
    ViewData["Title"] = "Registrar empresa";
}

<div class="page-header mb-4">
    <div>
        <span class="section-eyebrow">GESTIÓN EMPRESARIAL</span>
        <h1 class="page-title">Registrar empresa</h1>
        <p class="page-description">
            Registra la información de tu empresa para comenzar su evaluación de ciberseguridad.
        </p>
    </div>
    <div class="page-icon">
        <i class="bi bi-building-add"></i>
    </div>
</div>

<div class="form-card">
    <div class="form-card-header">
        <div class="form-icon">
            <i class="bi bi-building"></i>
        </div>
        <div>
            <h5>Información general</h5>
            <p>Completa los datos básicos de la organización.</p>
        </div>
    </div>

    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"></div>

        <div class="row g-4">
            <div class="col-12">
                <label asp-for="Nombre" class="form-label">
                    Nombre de la empresa
                </label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-building"></i>
                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ej. Comercializadora ABC" />
                </div>
                <span asp-validation-for="Nombre" class="field-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Sector" class="form-label">
                    Sector económico
                </label>
                <select asp-for="Sector" class="form-select">
                    <option value="">Seleccione un sector</option>
                    <option value="Comercio">Comercio</option>
                    <option value="Servicios">Servicios</option>
                    <option value="Otro">Otro</option>
                </select>
                <span asp-validation-for="Sector" class="field-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Municipio" class="form-label">
                    Municipio
                </label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-geo-alt"></i>
                    <input asp-for="Municipio"
                           class="form-control"
                           placeholder="Ej. Medellín" />
                </div>
                <span asp-validation-for="Municipio" class="field-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-light">
                Cancelar
            </a>
            <button type="submit" class="btn btn-accent">
                <i class="bi bi-check2-circle me-2"></i>
                Guardar empresa
            </button>
        </div>
    </form>
</div>