
@model IEnumerable<CiberseguridadPYMES.Models.Empresa>

@{
    ViewData["Title"] = "Mis empresas";
}

<h1>Mis empresas</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<p>
    <a asp-action="Crear" class="btn btn-primary">
        Registrar empresa
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no has registrado una empresa.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Sector</th>
                <th>Municipio</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var empresa in Model)
        {
            <tr>
                <td>@empresa.Nombre</td>
                <td>@empresa.Sector</td>
                <td>@empresa.Municipio</td>
                <td>
                    <a asp-action="Detalles"
                       asp-route-id="@empresa.Id"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a asp-action="Editar"
                       asp-route-id="@empresa.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@empresa.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
