@model IEnumerable<CiberseguridadPYMES.Models.Empresa>

@{
    ViewData["Title"] = "Mis empresas";
}

<div class="page-header mb-4">
    <div>
        <span class="section-eyebrow">PANEL DE ORGANIZACIONES</span>
        <h1 class="page-title">Mis empresas</h1>
        <p class="page-description">
            Administra las empresas registradas y consulta su información.
        </p>
    </div>

    <a asp-action="Crear" class="btn btn-accent">
        <i class="bi bi-plus-lg me-2"></i>
        Registrar empresa
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success custom-alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Mensaje"]
    </div>
}

<div class="stats-row mb-4">
    <div class="stat-card">
        <div class="stat-icon">
            <i class="bi bi-buildings"></i>
        </div>
        <div>
            <span class="stat-label">Empresas registradas</span>
            <strong class="stat-value">@Model.Count()</strong>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <div>
            <h5>Listado de empresas</h5>
            <p>Consulta y administra la información de tus organizaciones.</p>
        </div>
        <span class="count-badge">@Model.Count() registros</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-building"></i>
            </div>
            <h5>Aún no tienes empresas registradas</h5>
            <p>
                Registra tu primera empresa para comenzar a gestionar
                sus evaluaciones de ciberseguridad.
            </p>
            <a asp-action="Crear" class="btn btn-accent">
                <i class="bi bi-plus-lg me-2"></i>
                Registrar empresa
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table custom-table align-middle">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Sector económico</th>
                        <th>Municipio</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var empresa in Model)
                    {
                        <tr>
                            <td>
                                <div class="table-company">
                                    <div class="table-company-icon">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <strong>@empresa.Nombre</strong>
                                </div>
                            </td>
                            <td>
                                <span class="sector-badge">@empresa.Sector</span>
                            </td>
                            <td>
                                <span class="municipality-text">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    @empresa.Municipio
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="Detalles"
                                       asp-route-id="@empresa.Id"
                                       class="action-btn action-view"
                                       title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Editar"
                                       asp-route-id="@empresa.Id"
                                       class="action-btn action-edit"
                                       title="Editar empresa">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Eliminar"
                                       asp-route-id="@empresa.Id"
                                       class="action-btn action-delete"
                                       title="Eliminar empresa">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>