
@model CiberseguridadPYMES.Models.TipoSistema

@{
    ViewData["Title"] = "Eliminar tipo de sistema";
}

<h1>Eliminar tipo de sistema</h1>

<div class="alert alert-warning">
    ¿Estás seguro de que deseas eliminar este tipo de sistema?
</div>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Nombre:</strong> @Model.Nombre</p>
        <p><strong>Descripción:</strong> @Model.Descripcion</p>
    </div>
</div>

<form asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Confirmar eliminación
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>
