
@{
    ViewData["Title"] = "Registrar tipo de sistema";
}

<h1>Registrar tipo de sistema</h1>

<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label for="nombre" class="form-label">
            Nombre
        </label>
        <input id="nombre"
               name="nombre"
               class="form-control"
               value="@ViewData["Nombre"]"
               required />
    </div>

    <div class="mb-3">
        <label for="descripcion" class="form-label">
            Descripción
        </label>
        <textarea id="descripcion"
                  name="descripcion"
                  class="form-control"
                  rows="3">@ViewData["Descripcion"]</textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>
