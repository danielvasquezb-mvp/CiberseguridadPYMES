@model IEnumerable<CiberseguridadPYMES.Models.TipoSistema>

@{
    ViewData["Title"] = "Tipos de sistemas";

    var tipos = Model.ToList();
    int total = tipos.Count;
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN / CATÁLOGOS</span>
            <h1 class="page-title">Tipos de sistemas</h1>
            <p class="page-description">
                Administra las categorías de sistemas que pueden evaluar las empresas.
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Crear" class="btn-question-primary">
                <i class="bi bi-plus-lg"></i>
                Registrar tipo de sistema
            </a>
        }
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="question-alert success">
            <i class="bi bi-check-circle"></i>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="question-alert warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="question-stats">
        <div class="question-stat-card">
            <div class="question-stat-icon violet">
                <i class="bi bi-hdd-stack"></i>
            </div>
            <div>
                <span>Tipos registrados</span>
                <strong>@total</strong>
            </div>
        </div>

        <div class="question-stat-card">
            <div class="question-stat-icon green">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div>
                <span>Catálogo de sistemas</span>
                <strong>@total</strong>
            </div>
        </div>
    </div>

    <div class="question-table-card">

        <div class="question-table-header">
            <div>
                <h5>Catálogo de tipos de sistemas</h5>
                <p>Consulta y administra los tipos de sistemas registrados.</p>
            </div>

            <div class="question-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="buscarTipoSistema"
                       placeholder="Buscar tipo de sistema..." />
            </div>
        </div>

        @if (tipos.Any())
        {
            <div class="table-responsive">
                <table class="table question-table">
                    <thead>
                        <tr>
                            <th>Tipo de sistema</th>
                            <th>Descripción</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="tablaTiposSistema">
                        @foreach (var tipo in tipos)
                        {
                            <tr>
                                <td>
                                    <div class="system-type-name">
                                        <div class="system-type-icon">
                                            <i class="bi bi-pc-display"></i>
                                        </div>
                                        <div>
                                            <strong>@tipo.Nombre</strong>
                                            <small>Registro #@tipo.Id</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="system-type-description">
                                        @(string.IsNullOrWhiteSpace(tipo.Descripcion)
                                            ? "Sin descripción"
                                            : tipo.Descripcion)
                                    </span>
                                </td>

                                <td>
                                    <div class="question-actions">
                                        <a asp-action="Detalles"
                                           asp-route-id="@tipo.Id"
                                           class="question-action view"
                                           title="Ver detalles"
                                           aria-label="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <a asp-action="Editar"
                                               asp-route-id="@tipo.Id"
                                               class="question-action edit"
                                               title="Editar"
                                               aria-label="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <a asp-action="Eliminar"
                                               asp-route-id="@tipo.Id"
                                               class="question-action delete"
                                               title="Eliminar"
                                               aria-label="Eliminar">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="sinResultadosTipos" class="question-no-results" hidden>
                <i class="bi bi-search"></i>
                <p>No se encontraron tipos de sistemas.</p>
            </div>
        }
        else
        {
            <div class="question-empty">
                <i class="bi bi-hdd-stack"></i>
                <h5>No hay tipos de sistemas registrados</h5>
                <p>Los tipos de sistemas que registres aparecerán aquí.</p>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Crear" class="btn-question-primary mt-3">
                        <i class="bi bi-plus-lg"></i>
                        Registrar primer tipo
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const buscadorTipo = document.getElementById("buscarTipoSistema");
        const filasTipo = document.querySelectorAll("#tablaTiposSistema tr");
        const sinResultadosTipo = document.getElementById("sinResultadosTipos");

        buscadorTipo?.addEventListener("input", function () {
            const termino = this.value.toLowerCase().trim();
            let visibles = 0;

            filasTipo.forEach(fila => {
                const coincide = fila.textContent.toLowerCase().includes(termino);
                fila.style.display = coincide ? "" : "none";

                if (coincide) visibles++;
            });

            sinResultadosTipo.hidden = visibles !== 0;
        });
    </script>
}