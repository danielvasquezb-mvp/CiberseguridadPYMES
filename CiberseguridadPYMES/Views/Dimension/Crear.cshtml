@{
    ViewData["Title"] = "Registrar dimensión";
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">
                <i class="bi bi-layers"></i> CONFIGURACIÓN DE EVALUACIÓN
            </span>
            <h1 class="page-title">Registrar dimensión</h1>
            <p class="page-description">
                Define una nueva área para organizar las preguntas de evaluación de ciberseguridad.
            </p>
        </div>
    </div>

    <div class="question-form-container">
        <div class="question-form-card">
            <div class="question-form-heading">
                <div class="question-form-heading-icon">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <div>
                    <h2>Información de la dimensión</h2>
                    <p>Completa los datos para registrar la dimensión.</p>
                </div>
            </div>

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="question-validation"></div>

                <div class="question-form-grid">
                    <div class="question-field">
                        <label for="codigo">Código</label>
                        <input id="codigo"
                               name="codigo"
                               class="question-input"
                               value="@ViewData["Codigo"]"
                               placeholder="Ej. D1"
                               maxlength="10"
                               required />

                        <small>Identificador único, por ejemplo D1, D2 o D3.</small>
                    </div>

                    <div class="question-field">
                        <label for="nombre">Nombre de la dimensión</label>
                        <input id="nombre"
                               name="nombre"
                               class="question-input"
                               value="@ViewData["Nombre"]"
                               placeholder="Ej. Gestión de accesos"
                               maxlength="150"
                               required />
                    </div>

                    <div class="question-field full-width">
                        <label for="descripcion">Descripción</label>
                        <textarea id="descripcion"
                                  name="descripcion"
                                  class="question-input question-textarea"
                                  rows="5"
                                  placeholder="Describe qué aspectos de ciberseguridad evalúa esta dimensión.">@ViewData["Descripcion"]</textarea>
                        <small>Explica brevemente el alcance de esta área de evaluación.</small>
                    </div>
                </div>

                <div class="question-form-actions">
                    <button type="submit" class="btn-question-primary">
                        <i class="bi bi-check-lg"></i>
                        Guardar dimensión
                    </button>

                    <a asp-action="Index" class="btn-question-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>