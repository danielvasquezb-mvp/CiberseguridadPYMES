
@model IEnumerable<CiberseguridadPYMES.Models.Dimension>

@{
    ViewData["Title"] = "Dimensiones";
}

<h1>Dimensiones de evaluación</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        @TempData["Error"]
    </div>
}

@if (User.IsInRole("Administrador"))
{
    <p>
        <a asp-action="Crear" class="btn btn-primary">
            Registrar dimensión
        </a>
    </p>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay dimensiones registradas.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var dimension in Model)
        {
            <tr>
                <td>@dimension.Codigo</td>
                <td>@dimension.Nombre</td>
                <td>@dimension.Descripcion</td>
                <td>
                    <a asp-action="Detalles"
                       asp-route-id="@dimension.Id"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Editar"
                           asp-route-id="@dimension.Id"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Eliminar"
                           asp-route-id="@dimension.Id"
                           class="btn btn-danger btn-sm">
                            Eliminar
                        </a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
