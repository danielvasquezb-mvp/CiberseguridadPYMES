@model CiberseguridadPYMES.Models.Dimension

@{
    ViewData["Title"] = "Eliminar dimensión";
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">
                <i class="bi bi-layers"></i> CONFIGURACIÓN DE EVALUACIÓN
            </span>
            <h1 class="page-title">Eliminar dimensión</h1>
            <p class="page-description">
                Revisa la información antes de confirmar la eliminación.
            </p>
        </div>
    </div>

    <div class="question-delete-card">
        <div class="question-delete-heading">
            <div class="question-delete-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <h2>¿Confirmas la eliminación?</h2>
                <p>
                    Esta acción puede afectar las preguntas y evaluaciones relacionadas con esta dimensión.
                </p>
            </div>
        </div>

        <div class="question-delete-info">
            <div class="delete-info-row">
                <span>Código</span>
                <strong>@Model.Codigo</strong>
            </div>

            <div class="delete-info-row">
                <span>Nombre</span>
                <strong>@Model.Nombre</strong>
            </div>

            <div class="delete-info-row description-row">
                <span>Descripción</span>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.Descripcion)
                        ? "Sin descripción"
                        : Model.Descripcion)
                </p>
            </div>
        </div>

        <div class="question-delete-warning">
            <i class="bi bi-info-circle"></i>
            <span>
                Si existen preguntas asociadas a esta dimensión, es posible que el sistema impida eliminarla.
            </span>
        </div>

        <form asp-action="Eliminar"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <div class="question-form-actions">
                <button type="submit" class="btn-question-danger">
                    <i class="bi bi-trash3"></i>
                    Confirmar eliminación
                </button>

                <a asp-action="Index" class="btn-question-secondary">
                    <i class="bi bi-x-lg"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>