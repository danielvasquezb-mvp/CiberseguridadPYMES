
@model CiberseguridadPYMES.Models.Formulario

@{
    ViewData["Title"] = "Detalles del formulario";
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN / FORMULARIOS</span>
            <h1 class="page-title">Detalles del formulario</h1>
            <p class="page-description">
                Consulta la información y configuración del formulario.
            </p>
        </div>

        <a asp-action="Index" class="btn-question-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>
    </div>

    <div class="question-detail-card system-detail-container">

        <div class="question-detail-heading">
            <div class="question-form-heading-icon">
                <i class="bi bi-clipboard-check"></i>
            </div>

            <div>
                <span class="section-eyebrow">FORMULARIO DE EVALUACIÓN</span>
                <h2>@Model.Nombre</h2>
                <p>Información general del formulario registrado.</p>
            </div>

            <div class="question-detail-status">
                @if (Model.Activo)
                {
                    <span class="status-badge status-active">
                        <span></span> Activo
                    </span>
                }
                else
                {
                    <span class="status-badge status-inactive">
                        <span></span> Inactivo
                    </span>
                }
            </div>
        </div>

        <div class="question-detail-grid">
            <div class="question-detail-item">
                <span><i class="bi bi-card-text"></i> Nombre</span>
                <strong>@Model.Nombre</strong>
            </div>

            <div class="question-detail-item">
                <span><i class="bi bi-tag"></i> Versión</span>
                <strong>v@Model.Version</strong>
            </div>

            <div class="question-detail-item">
                <span><i class="bi bi-pc-display"></i> Tipo de sistema</span>
                <strong>@(Model.TipoSistema?.Nombre ?? "No especificado")</strong>
            </div>

            <div class="question-detail-item">
                <span><i class="bi bi-toggle-on"></i> Estado</span>
                <strong>@(Model.Activo ? "Activo" : "Inactivo")</strong>
            </div>
        </div>

        <div class="question-detail-actions">
            <a asp-action="Index" class="btn-question-secondary">
                Volver a formularios
            </a>

            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Editar"
                   asp-route-id="@Model.Id"
                   class="btn-question-primary">
                    <i class="bi bi-pencil-square"></i>
                    Editar formulario
                </a>
            }
        </div>
    </div>
</div>
