
@model CiberseguridadPYMES.Models.Formulario

@{
    ViewData["Title"] = "Eliminar formulario";
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN / FORMULARIOS</span>
            <h1 class="page-title">Eliminar formulario</h1>
            <p class="page-description">
                Revisa la información antes de confirmar esta operación.
            </p>
        </div>

        <a asp-action="Index" class="btn-question-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>
    </div>

    <div class="question-delete-card system-delete-container">

        <div class="question-delete-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <div class="question-delete-heading">
            <h2>¿Eliminar este formulario?</h2>
            <p>
                Esta acción puede estar impedida si existen preguntas o evaluaciones relacionadas.
                Verifica los datos antes de continuar.
            </p>
        </div>

        <div class="question-delete-info">
            <div>
                <span>Nombre</span>
                <strong>@Model.Nombre</strong>
            </div>

            <div>
                <span>Versión</span>
                <strong>v@Model.Version</strong>
            </div>

            <div>
                <span>Tipo de sistema</span>
                <strong>@(Model.TipoSistema?.Nombre ?? "No especificado")</strong>
            </div>

            <div>
                <span>Estado</span>
                <strong>@(Model.Activo ? "Activo" : "Inactivo")</strong>
            </div>
        </div>

        <div class="question-delete-warning">
            <i class="bi bi-info-circle"></i>
            <span>
                Si el formulario tiene registros relacionados, el sistema puede impedir su eliminación.
            </span>
        </div>

        <form asp-action="Eliminar"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <div class="question-form-actions">
                <a asp-action="Index" class="btn-question-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn-question-danger">
                    <i class="bi bi-trash3"></i>
                    Confirmar eliminación
                </button>
            </div>
        </form>
    </div>
</div>
