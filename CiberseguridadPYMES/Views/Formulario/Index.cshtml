
@model IEnumerable<CiberseguridadPYMES.Models.Formulario>

@{
    ViewData["Title"] = "Formularios";
    var formularios = Model.ToList();
    var total = formularios.Count;
    var activos = formularios.Count(f => f.Activo);
    var inactivos = total - activos;
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN</span>
            <h1 class="page-title">Formularios de evaluación</h1>
            <p class="page-description">
                Administra los formularios utilizados para evaluar la ciberseguridad de las empresas.
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Crear" class="btn-question-primary">
                <i class="bi bi-plus-lg"></i>
                Registrar formulario
            </a>
        }
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="question-alert question-alert-success">
            <i class="bi bi-check-circle"></i>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="question-alert question-alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="question-stats">
        <div class="question-stat-card">
            <div class="question-stat-icon purple">
                <i class="bi bi-clipboard-data"></i>
            </div>
            <div>
                <span>Total de formularios</span>
                <strong>@total</strong>
            </div>
        </div>

        <div class="question-stat-card">
            <div class="question-stat-icon green">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <span>Formularios activos</span>
                <strong>@activos</strong>
            </div>
        </div>

        <div class="question-stat-card">
            <div class="question-stat-icon gray">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <span>Formularios inactivos</span>
                <strong>@inactivos</strong>
            </div>
        </div>
    </div>

    <div class="question-table-card">
        <div class="question-table-heading">
            <div>
                <h2>Formularios registrados</h2>
                <p>Consulta la información y el estado de cada formulario.</p>
            </div>

            <div class="question-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="buscarFormulario"
                       placeholder="Buscar formulario..." />
            </div>
        </div>

        @if (!formularios.Any())
        {
            <div class="question-empty">
                <i class="bi bi-clipboard-x"></i>
                <h3>No hay formularios registrados</h3>
                <p>Cuando registres un formulario, aparecerá en esta sección.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="question-table" id="tablaFormularios">
                    <thead>
                        <tr>
                            <th>Formulario</th>
                            <th>Versión</th>
                            <th>Tipo de sistema</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var formulario in formularios)
                    {
                        <tr>
                            <td>
                                <div class="system-type-name">
                                    <div class="system-type-icon">
                                        <i class="bi bi-clipboard-check"></i>
                                    </div>
                                    <div>
                                        <strong>@formulario.Nombre</strong>
                                        <small>Formulario de evaluación</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="version-badge">v@(formulario.Version)</span>
                            </td>
                            <td>
                                <span class="system-category">
                                    <i class="bi bi-pc-display"></i>
                                    @(formulario.TipoSistema?.Nombre ?? "No especificado")
                                </span>
                            </td>
                            <td>
                                @if (formulario.Activo)
                                {
                                    <span class="status-badge status-active">
                                        <span></span> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <span></span> Inactivo
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="question-actions">
                                    <a asp-action="Detalles"
                                       asp-route-id="@formulario.Id"
                                       class="question-action-btn details"
                                       title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Editar"
                                           asp-route-id="@formulario.Id"
                                           class="question-action-btn edit"
                                           title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Eliminar"
                                           asp-route-id="@formulario.Id"
                                           class="question-action-btn delete"
                                           title="Eliminar">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div id="sinResultadosFormularios" class="question-no-results" style="display:none;">
                <i class="bi bi-search"></i>
                No se encontraron formularios con ese criterio.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const buscadorFormulario = document.getElementById("buscarFormulario");
        const filasFormulario = document.querySelectorAll("#tablaFormularios tbody tr");
        const sinResultadosFormulario = document.getElementById("sinResultadosFormularios");

        if (buscadorFormulario) {
            buscadorFormulario.addEventListener("input", function () {
                const termino = this.value.toLowerCase().trim();
                let visibles = 0;

                filasFormulario.forEach(fila => {
                    const coincide = fila.textContent.toLowerCase().includes(termino);
                    fila.style.display = coincide ? "" : "none";

                    if (coincide) visibles++;
                });

                if (sinResultadosFormulario) {
                    sinResultadosFormulario.style.display = visibles === 0 ? "block" : "none";
                }
            });
        }
    </script>
}
