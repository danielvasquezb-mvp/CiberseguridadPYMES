
@{
    ViewData["Title"] = "Registrar formulario";
}

<div class="question-page">

    <div class="question-header">
        <div>
            <span class="section-eyebrow">CONFIGURACIÓN / FORMULARIOS</span>
            <h1 class="page-title">Registrar formulario</h1>
            <p class="page-description">
                Define un formulario y relaciónalo con el tipo de sistema que será evaluado.
            </p>
        </div>

        <a asp-action="Index" class="btn-question-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>
    </div>

    <div class="question-form-card system-form-container">
        <div class="question-form-heading">
            <div class="question-form-heading-icon">
                <i class="bi bi-clipboard-plus"></i>
            </div>
            <div>
                <h2>Información del formulario</h2>
                <p>Completa los datos solicitados para registrar el formulario.</p>
            </div>
        </div>

        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="question-validation"></div>
            }

            <div class="question-form-grid">
                <div class="question-field question-field-full">
                    <label for="nombre">Nombre del formulario</label>
                    <input id="nombre"
                           name="nombre"
                           class="question-input"
                           value="@ViewData["Nombre"]"
                           maxlength="150"
                           placeholder="Ej. Evaluación de seguridad de aplicaciones"
                           required />
                    <small>Nombre que permitirá identificar el formulario.</small>
                </div>

                <div class="question-field">
                    <label for="version">Versión</label>
                    <input id="version"
                           name="version"
                           class="question-input"
                           value="@(ViewData["Version"] ?? "1.0")"
                           maxlength="20"
                           placeholder="Ej. 1.0"
                           required />
                    <small>Identificador de la versión del formulario.</small>
                </div>

                <div class="question-field">
                    <label for="tipoSistemaId">Tipo de sistema</label>
                    <select id="tipoSistemaId"
                            name="tipoSistemaId"
                            class="question-select"
                            asp-items="ViewBag.TiposSistema"
                            required>
                        <option value="">Seleccione un tipo de sistema</option>
                    </select>
                    <small>Tipo de sistema al que estará asociado.</small>
                </div>
            </div>

            <div class="question-active-option">
                <div class="question-active-info">
                    <i class="bi bi-toggle-on"></i>
                    <div>
                        <strong>Formulario activo</strong>
                        <span>Permite que el formulario esté disponible para su utilización.</span>
                    </div>
                </div>

                <div class="form-check form-switch">
                    <input id="activo"
                           name="activo"
                           type="checkbox"
                           value="true"
                           class="form-check-input"
                           checked="@(ViewData["Activo"] == null || (bool)ViewData["Activo"])" />
                    <input type="hidden" name="activo" value="false" />
                </div>
            </div>

            <div class="question-form-actions">
                <a asp-action="Index" class="btn-question-secondary">Cancelar</a>
                <button type="submit" class="btn-question-primary">
                    <i class="bi bi-check-lg"></i>
                    Guardar formulario
                </button>
            </div>
        </form>
    </div>
</div>
